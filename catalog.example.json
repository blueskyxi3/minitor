{
  "manifest": {
    "id": "monitor",
    "name": "性能监控",
    "version": "0.0.2",
    "sdk_version": 2,
    "extensions": ["console.navigation"],
    "entry": "/assets/plugin.js",
    "navigation": { "group": "OBSERVABILITY" }
  },
  "description": "内置 VictoriaMetrics，展示网关、模型和 Billing Worker 的性能与采集状态。",
  "logo": "https://raw.githubusercontent.com/blueskyxi3/minitor/main/plugin-logos/monitor.png",
  "background": "https://raw.githubusercontent.com/blueskyxi3/minitor/main/plugin-backgrounds/monitor.png",
  "modes": ["process", "docker", "kubernetes"],
  "artifacts": {
    "darwin-arm64": "https://github.com/blueskyxi3/minitor/releases/download/0.0.2/monitor-0.0.2-darwin-arm64.zip",
    "linux-amd64": "https://github.com/blueskyxi3/minitor/releases/download/0.0.2/monitor-0.0.2-linux-amd64.zip",
    "linux-arm64": "https://github.com/blueskyxi3/minitor/releases/download/0.0.2/monitor-0.0.2-linux-arm64.zip"
  },
  "env_prefix": "MONITOR",
  "rollback_compatible": true
}
